// Prisma schema for authentication and knowledge base

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String
  name                   String?
  refreshTokenHash       String?
  refreshTokenExpiresAt  DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Amazon Scraping History
model AmazonScrapeLog {
  id          String   @id @default(cuid())
  category    String?
  keywords    String?
  source      String   @default("amazon_bestsellers")
  productsCount Int    @default(0)
  status      String   @default("pending") // pending, success, failed
  error       String?  @db.Text
  startedAt   DateTime @default(now())
  completedAt DateTime?
  metadata    Json?
  
  @@index([category])
  @@index([status])
  @@index([startedAt])
}

// Scraped Amazon Product (cached data)
model AmazonProduct {
  id            String   @id @default(cuid())
  asin          String   @unique
  title         String   @db.Text
  price         Decimal? @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  rating        Float?
  reviewCount   Int      @default(0)
  badge         String?
  imageUrl      String?  @db.Text
  productUrl    String   @db.Text
  category      String?
  prime         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  scrapeLogId   String?
  
  @@index([asin])
  @@index([category])
  @@index([createdAt])
}

// Knowledge Base Document model for RAG
// Used by MySQL FULLTEXT provider as fallback
model KnowledgeBaseDocument {
  id        String   @id @default(cuid())
  content   String   @db.Text
  metadata  Json?
  source    String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([createdAt])
}


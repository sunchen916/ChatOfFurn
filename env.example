# ===========================================
# DeepSeek API（对话用，OpenAI 兼容格式）
# ===========================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===========================================
# 向量数据库配置
# ===========================================
# 支持四种模式（通过 VECTOR_DB_TYPE 切换）：
# - chroma: Chroma 向量数据库（本地或远程）
# - supabase: Supabase pgvector（云端 PostgreSQL）
# - mysql: MySQL FULLTEXT（回退方案，关键词匹配）
# - hybrid: 混合检索（BM25 + kNN + RRF + 重排），推荐开启
#
# 优先级：VECTOR_DB_TYPE > HYBRID_ENABLED > 自动检测

# 启用混合检索（BM25 + kNN + RRF 融合 + 重排）
# 当配置了 Supabase 或 Chroma 时，设为 true 可启用
HYBRID_ENABLED=true

# 向量数据库类型（可选，默认自动检测；设为 hybrid 强制使用混合检索）
# VECTOR_DB_TYPE=supabase  # chroma | supabase | mysql | hybrid

# ---- Chroma 配置（VECTOR_DB_TYPE=chroma 时使用）----
CHROMA_PERSIST_DIR=./chroma_data
# CHROMA_PORT=8000  # 可选，默认 8000

# ---- Supabase pgvector 配置（VECTOR_DB_TYPE=supabase 时使用）----
# Supabase 项目 URL
# SUPABASE_URL=https://your-project-id.supabase.co
# Supabase API Key（ANON KEY 或 SERVICE ROLE KEY）
# SUPABASE_KEY=your-supabase-key-here
# 向量表名（可选，默认 kb_documents）
# SUPABASE_VECTOR_TABLE=kb_documents

# ---- MySQL 配置（VECTOR_DB_TYPE=mysql 或作为回退时使用）----
# Prisma 数据库连接（用于业务数据和 MySQL FULLTEXT 回退）
DATABASE_URL="mysql://user:password@localhost:3306/database_name"

# ===========================================
# JWT 认证配置
# ===========================================
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# ===========================================
# Embedding API 配置（用于 RAG 向量化）
# ===========================================
# SiliconFlow API（推荐，用于 embedding 模型调用）
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ===========================================
# 代理配置（可选）
# ===========================================
# 禁用代理设为 1
# AI_DISABLE_PROXY=1
# 或指定代理 URL
# OPENAI_PROXY_URL=http://127.0.0.1:7890
